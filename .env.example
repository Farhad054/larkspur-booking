# Postgres. On Neon, DATABASE_URL is the pooled connection string and DIRECT_URL the direct one
# (used by `prisma migrate deploy`). Locally both can be the same URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/booking"
DIRECT_URL=""

# Password for /admin. If unset, the admin area is disabled.
ADMIN_PASSWORD=""
# Random string (e.g. `openssl rand -hex 32`) used to sign the admin session cookie.
SESSION_SECRET=""

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: without RESEND_API_KEY, emails are skipped (logged) and everything else still works.
RESEND_API_KEY=""
EMAIL_FROM=""

# Optional: separate database for `npm test` / `npm run test:e2e` (they wipe it!)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:54329/booking_test"
